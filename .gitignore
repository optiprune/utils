# Ignore all test directories and fixtures
**/tests/**
**/test/**
**/fixtures/**
!tests/
!tests/fixtures/
!tests/**/*.js
!tests/fixtures/**/*.js

# Build artifacts & package manager directories
dist/**
coverage/**
**/node_modules/**
.pnpm-store/**

# Benchmark outputs & reports
benchmark-results.json
*.log

# Prune Cache
.optiprune/
