{
  "name": "@optiprune/pathx",
  "version": "0.1.2",
  "description": "Zero-dependency fast path primitives for optiprune.",
  "keywords": [
    "cross-platform",
    "filesystem",
    "nodejs",
    "path",
    "paths"
  ],
  "homepage": "https://github.com/optiprune/utils/tree/main/packages/pathx",
  "bugs": {
    "url": "https://github.com/optiprune/utils/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optiprune/utils.git",
    "directory": "packages/pathx"
  },
  "files": [
    "src",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "test": "vitest run --root ../.. --config vitest.config.js tests/pathx.test.js",
    "test:coverage": "vitest run --root ../.. --config vitest.config.js --coverage tests/pathx.test.js"
  },
  "engines": {
