# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly enforce text files
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts & CLI binaries need strict LF
*.sh text eol=lf
src/cli.js text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary