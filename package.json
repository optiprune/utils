{
  "name": "@optiprune/main",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-dependency iterative filesystem crawler with fast path primitives.",
  "homepage": "https://github.com/optiprune/utils",
  "bugs": {
    "url": "https://github.com/optiprune/utils/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optiprune/utils.git"
  },
  "bin": {
    "fast-crawl": "./src/cli.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "src",
    "packages",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "bench": "node bench/crawl.js",
    "bench:compare": "node bench/compare.js",
    "fmt": "oxfmt --ignore-path .oxfmtignore",
    "fmt:check": "oxfmt --ignore-path .oxfmtignore --check"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "oxfmt": "0.72.0",
    "tinyglobby": "^0.2.17",
    "vitest": "^3.2.7"
  }
}
