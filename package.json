{
  "name": "@optiprune/main",
  "version": "0.0.0",
  "private": true,
  "description": "Zero-dependency iterative filesystem crawler with fast path primitives.",
  "bin": {
    "fast-crawl": "./src/cli.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "src",
    "packages",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "bench": "node bench/crawl.js",
    "bench:compare": "node bench/compare.js",
    "fmt": "oxfmt --ignore-path .oxfmtignore"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "oxfmt": "0.72.0",
    "vitest": "^3.2.7"
  }
}
